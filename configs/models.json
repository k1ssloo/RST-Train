      "params_b": 0.87,
      "bf16_gib": 1.6,
      "n_layers": 24,
      "hybrid_attention": true,
      "has_vision": true,
      "moe": false,
      "min_gpus": 2,
      "serve_tp": 1,
      "serve_enable_thinking": true,
      "est_epoch_minutes": 5,
      "paper_reference": null,
      "role": "pipeline smoke test -- validates conversion / CP / mask / eval end-to-end cheaply",
      "parallelism": {
        "80GB": {
          "tp": 1,
          "pp": 1,
          "cp": 2,
          "max_tokens_per_gpu": 16384
